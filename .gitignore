# Dependencies (package-lock.json IS committed, so `npm install` gives
# everyone the exact same versions that were tested here)
node_modules/

# Secrets and state (NEVER commit)
#
# Every .json under server-bot/ is ignored as a rule, not one file at a time.
# The old list had to be extended by hand for each new credential, which is a
# race nobody wins: the file that gets forgotten is the one that leaks. No
# tracked source file lives there as .json, so this costs nothing.
server-bot/*.json
server-bot/**/*.json
# Named anyway, so it is obvious what the rule above is protecting:
#   telegram.json  claude-token.json  adzuna-key.json
#   gmail-oauth.json  gmail-token.json
#   telegram-offset.json  last-scan.json  linkedin-state.json
#
# Same rule for .jsonl. These hold your own words about specific employers —
# why you turned an offer down — which is the most personal thing the bot
# writes down. Listing them one by one had already missed feedback-errors.jsonl;
# no tracked source file uses this extension, so the blanket rule costs nothing.
#   feedback.jsonl  feedback-applied.jsonl  feedback-errors.jsonl
server-bot/*.jsonl
server-bot/**/*.jsonl
server-bot/*.log
server-bot/**/*.log

# Activity and output data (keep the folders, ignore their contents)
data/*
!data/.gitkeep
output/*
!output/.gitkeep

# Scratch dumps at the root. A redirect run from the wrong working directory
# is all it takes to commit a pile of scraped postings; loose data files stop
# here so that slip cannot happen.
/*.txt
/*.jsonl
/*.tsv
!README*.txt

# The setup caches ESCO answers on disk; the classification is fixed,
# so this is a local speed-up, never something to ship.
.esco-cache/

# local setup-replay scratch copy
.setup-test-work/
